rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPERS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedInAs(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // The only super-admin authority is the `superAdmin` custom claim, which
    // can be set only by the trusted Admin SDK / operations CLI. A role field
    // inside a Firestore document is display data and never grants access.
    function isSuperAdmin() {
      return isAuthenticated()
        && request.auth.token.get('superAdmin', false) == true;
    }

    function isValidClinicId(clinicId) {
      return clinicId.matches('^CLN-[0-9]{5}$');
    }

    function isActiveClinic(clinicId) {
      return exists(/databases/$(database)/documents/clinics/$(clinicId))
        && get(/databases/$(database)/documents/clinics/$(clinicId)).data.get('isActive', false) == true;
    }

    function isActiveMember(uid, clinicId) {
      return exists(/databases/$(database)/documents/clinic_members/$(uid + '_' + clinicId))
        && get(/databases/$(database)/documents/clinic_members/$(uid + '_' + clinicId)).data.get('isActive', false) == true;
    }

    function isClinicAdmin(uid, clinicId) {
      return isActiveMember(uid, clinicId)
        && get(/databases/$(database)/documents/clinic_members/$(uid + '_' + clinicId)).data.get('role', '') == 'clinic_admin';
    }

    // Only an active clinic_admin may manage memberships. Front-desk leads
    // may operate the queue but may not grant roles.
    function isClinicManager(uid, clinicId) {
      return isAuthenticated() && isClinicAdmin(uid, clinicId);
    }

    // Queue operations are allowed for clinic_admin and front_desk_lead.
    function canManageClinic(uid, clinicId) {
      return isAuthenticated() && (
        isClinicAdmin(uid, clinicId)
        || (isActiveMember(uid, clinicId)
          && get(/databases/$(database)/documents/clinic_members/$(uid + '_' + clinicId)).data.get('role', '') == 'front_desk_lead')
      );
    }

    function canViewClinic(uid, clinicId) {
      return isAuthenticated() && isActiveMember(uid, clinicId);
    }

    // =========================================================================
    // USERS — document ID is the Firebase Auth UID.
    // Fields: email, displayName, photoUrl, role, clinicId, createdAt,
    //         updatedAt, isActive. There is deliberately no `uid` field.
    // A client may self-create only a patient profile. The super-admin
    // profile is created by the trusted operator or by a claimed super admin.
    // =========================================================================

    match /users/{userId} {
      allow get: if isSignedInAs(userId) || isSuperAdmin();

      // The super-admin console lists every profile. Ordinary users read
      // only their own document with a direct get.
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin() || (
        isSignedInAs(userId)
        && request.resource.data.role == 'patient'
        && request.resource.data.isActive == true
      );

      allow update: if isSuperAdmin() || (
        isSignedInAs(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
      );

      // Play Store account-deletion requirement: a patient may delete only
      // their own profile. Staff profiles are retained for clinic audit and
      // must be removed through the trusted clinic offboarding process.
      allow delete: if isSuperAdmin() || (
        isSignedInAs(userId)
        && resource.data.role == 'patient'
      );
    }

    // =========================================================================
    // CLINICS - document ID is the clinic ID (CLN-XXXXX).
    // Patient discovery needs read access for every signed-in user. The
    // document must never contain a staff identifier or other private field.
    // Clients cannot create clinics. A super admin or an active clinic_admin
    // may update clinic content.
    // =========================================================================

    match /clinics/{clinicId} {
      allow read: if isAuthenticated();

      allow create: if isSuperAdmin() && isValidClinicId(clinicId);

      allow update: if isSuperAdmin() || (
        isAuthenticated() && isClinicAdmin(request.auth.uid, clinicId)
      );

      allow delete: if false;
    }

    // =========================================================================
    // CLINIC_MEMBERS — document ID is {userId}_{clinicId}.
    // Fields: userId, clinicId, role, permissions, isActive, joinedAt,
    //         assignedBy.
    // Memberships are provisioned only by the super-admin console or trusted
    // tooling (Admin SDK). The applicant client can never create, activate or
    // elevate its own membership.
    // =========================================================================

    match /clinic_members/{membershipId} {
      allow get: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.get('userId', '') == request.auth.uid
          || isClinicManager(request.auth.uid, resource.data.get('clinicId', ''))
        )
      );

      allow list: if isSuperAdmin();
      allow list: if isAuthenticated()
        && resource.data.get('userId', '') == request.auth.uid;
      allow list: if isAuthenticated()
        && isClinicManager(request.auth.uid, resource.data.get('clinicId', ''));

      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // ADMIN_ACCESS_REQUESTS — document ID is {uid}_{clinicId}.
    // The applicant may create only a pending request for its own UID and
    // read only its own requests. Approval/rejection is a super-admin action.
    // =========================================================================

    match /admin_access_requests/{requestId} {
      allow get: if isSuperAdmin() || (
        isAuthenticated()
        && resource.data.get('uid', '') == request.auth.uid
      );

      allow list: if isSuperAdmin();
      allow list: if isAuthenticated()
        && resource.data.get('uid', '') == request.auth.uid;

      allow create: if isAuthenticated()
        && requestId == request.auth.uid + '_' + request.resource.data.requestedClinicId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'requestedClinicId',
          'contactNumber',
          'status',
          'createdAt',
          'updatedAt',
          'reviewedAt',
          'reviewedBy',
          'rejectionReason'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.contactNumber is string
        && request.resource.data.status == 'pending'
        && isValidClinicId(request.resource.data.requestedClinicId)
        && isActiveClinic(request.resource.data.requestedClinicId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == null;

      allow update: if isSuperAdmin()
        && resource.data.get('status', '') == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // QUEUE_SESSIONS — document ID is {clinicId}_{YYYY-MM-DD}.
    // Readable by every signed-in user so patient discovery can show live
    // parchi counts. Writes require clinic staff membership or super admin.
    // =========================================================================

    match /queue_sessions/{sessionId} {
      allow read: if isAuthenticated();

      allow create: if (isSuperAdmin() || canManageClinic(request.auth.uid, request.resource.data.clinicId))
        && sessionId == request.resource.data.clinicId + '_' + request.resource.data.date
        && request.resource.data.currentParchaNumber is int
        && request.resource.data.currentParchaNumber >= 0
        && request.resource.data.status in ['active', 'paused', 'closed'];

      allow update: if (isSuperAdmin() || canManageClinic(request.auth.uid, resource.data.clinicId))
        && request.resource.data.clinicId == resource.data.clinicId
        && request.resource.data.date == resource.data.date
        && request.resource.data.currentParchaNumber is int
        && request.resource.data.currentParchaNumber >= 0
        && request.resource.data.status in ['active', 'paused', 'closed'];

      allow delete: if false;
    }

    // =========================================================================
    // QUEUE_HISTORY — immutable audit trail.
    // =========================================================================

    match /queue_history/{historyId} {
      allow get: if isSuperAdmin() || (
        isAuthenticated()
        && canViewClinic(request.auth.uid, resource.data.get('clinicId', ''))
      );

      allow list: if isSuperAdmin();
      allow list: if isAuthenticated()
        && canViewClinic(request.auth.uid, resource.data.get('clinicId', ''));

      allow create: if isSuperAdmin() || (
        isAuthenticated()
        && canManageClinic(request.auth.uid, request.resource.data.clinicId)
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.action in ['increment', 'correction', 'reset']
      );

      allow update, delete: if false;
    }

    // =========================================================================
    // SUPER_ADMIN_AUDIT_LOGS — append-only mirror written by the console.
    // =========================================================================

    match /super_admin_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
