rules_version = '2';

// Doctor photos are public to signed-in app users because patients must render
// them on the clinic page. Writes are limited to an active clinic_admin of the
// matching clinic and to image files under 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /clinics/{clinicId}/doctor_photo {
      allow read: if true;

      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.exists(
          /databases/(default)/documents/clinic_members/$(request.auth.uid + '_' + clinicId)
        )
        && firestore.get(
          /databases/(default)/documents/clinic_members/$(request.auth.uid + '_' + clinicId)
        ).data.isActive == true
        && firestore.get(
          /databases/(default)/documents/clinic_members/$(request.auth.uid + '_' + clinicId)
        ).data.role == 'clinic_admin';
    }

    // Deny everything that is not explicitly allowed above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
